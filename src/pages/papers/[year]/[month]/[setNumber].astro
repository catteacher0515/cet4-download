---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { papers } from "../../../../data/cet4";
import pdfReaderScript from "../../../../scripts/pdf-reader.ts?url";

export function getStaticPaths() {
  return papers.map((paper) => ({
    params: {
      year: String(paper.year),
      month: String(paper.month),
      setNumber: String(paper.setNumber)
    },
    props: {
      paper
    }
  }));
}

const { paper } = Astro.props;
---

<BaseLayout
  title={`${paper.title} - 在线预览`}
  description={`${paper.title} 在线预览与 PDF 下载。`}
  pathname="/papers"
  shellClassName="site-shell--reader"
  mainClassName="reader-main"
  hideHeader
  hideFooter
>
  <section class="reader-page">
    <div class="reader-stage">
      <div class="reader-stage__toolbar">
        <div class="reader-stage__toolbar-start">
          <a class="reader-toolbar-button reader-toolbar-button--ghost" href="/papers">
            返回真题列表
          </a>
        </div>
        <div class="reader-stage__labels">
          <span>PDF 阅读器</span>
          <span>{paper.title}</span>
        </div>
        <div class="reader-stage__toolbar-end">
          <a class="reader-toolbar-button reader-toolbar-button--primary" href={paper.pdfPath} download>
            下载 PDF
          </a>
        </div>
      </div>

      <div
        class="reader-pdfjs"
        data-reader-pdfjs
        data-pdf-url={paper.pdfPath}
        data-pdf-title={paper.title}
      >
        <div class="reader-pdfjs__meta">
          <p class="reader-pdfjs__status" data-reader-status>
            正在初始化预览器...
          </p>
        </div>
        <div class="reader-pdfjs__pages" data-reader-pages></div>
      </div>
    </div>
  </section>

  {
    paper.audioPath ? (
      <aside class="reader-audio-bar" aria-label="听力音频">
        <button class="reader-audio-bar__toggle" type="button" data-audio-toggle aria-label="播放或暂停">
          ▶
        </button>
        <div class="reader-audio-bar__time">
          <span class="reader-audio-bar__time-current" data-audio-current>00:00</span>
          <span>/</span>
          <span class="reader-audio-bar__time-total" data-audio-total>00:00</span>
        </div>
        <input
          class="reader-audio-bar__seek"
          type="range"
          min="0"
          max="0"
          value="0"
          step="0.1"
          data-audio-seek
          aria-label="音频播放进度"
        />
        <div class="reader-audio-bar__actions">
          <button class="reader-audio-bar__text" type="button">听力原文</button>
          <button class="reader-audio-bar__text" type="button">答案区</button>
        </div>
        <audio class="reader-audio-bar__media" preload="metadata" data-audio-media>
          <source src={paper.audioPath} type="audio/mp4" />
          你的浏览器暂不支持音频播放，请直接下载后使用。
        </audio>
      </aside>
    ) : null
  }

  <script type="module" src={pdfReaderScript}></script>
</BaseLayout>
