---
import type { Cet4Paper } from "../data/cet4";

interface Props {
  paper: Cet4Paper;
}

const { paper } = Astro.props;
const previewHref = `/papers/${paper.year}/${paper.month}/${paper.setNumber}/`;
---

<article class="paper-card">
  <a class="paper-card__preview-link" href={previewHref} aria-label={`进入 ${paper.title} 在线预览页`}>
    <div class="paper-card__preview">
      {
        paper.previewImagePath ? (
          <img
            class="paper-card__preview-image"
            src={paper.previewImagePath}
            alt={`${paper.title} 预览图`}
            loading="lazy"
          />
        ) : (
          <div class="paper-card__sheet" aria-hidden="true"></div>
        )
      }
    </div>
  </a>

  <div class="paper-card__body">
    <div class="paper-card__head">
      <div>
        <h2 class="paper-card__title">{paper.title}</h2>
      </div>
      <span class="paper-card__badge">第{paper.setNumber}套</span>
    </div>

    <p class="paper-card__meta">点击卡片在线预览，或直接下载 PDF。</p>

    <div class="paper-card__actions">
      <a class="paper-card__button paper-card__button--secondary" href={previewHref}>
        在线预览
      </a>
      <a class="paper-card__button paper-card__button--primary" href={paper.pdfPath} download>
        下载 PDF
      </a>
    </div>
  </div>
</article>
